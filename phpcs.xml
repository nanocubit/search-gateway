<?xml version="1.0"?>
<ruleset name="SearchGateway">
    <description>PSR-12 coding standard for Search Gateway (lineLimit=140, Symfony-style)</description>
    <file>src</file>
    <file>tests</file>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength.TooLong"/>
    </rule>
    <rule ref="Generic.Files.LineLength">
    <!-- Исключение для тестов: разрешаем несколько классов в одном файле -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>     
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
